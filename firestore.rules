rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRegisteredManager() {
      return isAuthenticated() && 
        (request.auth.token.email == "huzaifaduet@gmail.com" || 
         exists(/databases/$(database)/documents/managers/$(request.auth.token.email)));
    }

    // Managers collection: read to verify registration, write by authorized managers
    match /managers/{managerEmail} {
      allow read: if true;
      allow write: if isRegisteredManager() || request.auth.token.email == "huzaifaduet@gmail.com" || !exists(/databases/$(database)/documents/managers/$(managerEmail));
    }

    // Public read for boarders and transparency, write for manager operations
    match /boarders/{boarderId} {
      allow read: if true;
      allow write: if true;
    }

    match /deposits/{depositId} {
      allow read: if true;
      allow write: if true;
    }

    match /bazaarCosts/{bazaarId} {
      allow read: if true;
      allow write: if true;
    }

    match /mealLogs/{date} {
      allow read: if true;
      allow write: if true;
    }

    match /miscCosts/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
